# ---------------------------------------------------------------------------
# Blockwright environment
# Copy to .env.local and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# Public site URL (used for auth redirects, OG metadata, Studio plugin config)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (required) ---------------------------------------------------
# Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only. Bypasses RLS. Required ONLY by the Roblox Studio bridge, which
# authenticates with its own plugin token and has no user session. Auth,
# projects, chat and credits all work without it.
SUPABASE_SERVICE_ROLE_KEY=

# --- QA fixtures (optional) -------------------------------------------------
# Two confirmed accounts, used only by `npm run verify:security` to prove
# cross-tenant isolation against a live database. Never set these in production.
QA_USER_A=
QA_USER_B=
QA_PASSWORD=

# --- AI providers (at least one required) ----------------------------------
# Models whose provider has no key are shown in the picker as unavailable,
# naming the key that is missing. Nothing else breaks.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# OpenRouter unlocks ~400 models through one key, including the dynamically
# discovered free tier. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# How long a fetched OpenRouter catalog is treated as fresh (default 30 min).
# A stale snapshot is still served while a refresh runs behind it.
OPENROUTER_CATALOG_TTL_MS=

# --- Optional ---------------------------------------------------------------
# Comma-separated OAuth providers you have actually enabled in Supabase
# (google, github, discord). Leave empty for password-only sign-in — the UI
# says so plainly rather than showing buttons that would fail.
NEXT_PUBLIC_AUTH_PROVIDERS=
