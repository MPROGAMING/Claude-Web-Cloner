  "overlap_rules": [
    {
      "id": "OV-001",
      "topic": "Luau language semantics",
      "canonical": {
        "source_id": "site.language-reference",
        "path": "src/content/docs/**"
      },
      "secondary": {
        "source_id": "creator-docs.luau-intro",
        "path": "content/en-us/luau/**"
      },
      "resolution": "On any conflict about language semantics, the Luau site wins. creator-docs Luau pages are retained as beginner-facing Roblox framing.",
      "enforcement": "authority field + retrieval re-ranking"
    },
    {
      "id": "OV-002",
      "topic": "Roblox Engine API",
      "canonical": {
        "source_id": "creator-docs.engine-api",
        "path": "content/en-us/reference/engine/**/*.yaml"
      },
      "secondary": null,
      "resolution": "The structured YAML is the only complete source. Live .md pages are a lossy projection and are not ingested.",
      "enforcement": "sole source"
    },
    {
      "id": "OV-003",
      "topic": "Roblox runtime and scripting",
      "canonical": {
        "source_id": "creator-docs.scripting",
        "path": "content/en-us/scripting/**"
      },
      "secondary": null,
      "resolution": "Sole source. Distinct from language documentation: covers services, events, security, capabilities and the scheduler.",
      "enforcement": "sole source"
    },
    {
      "id": "OV-004",
      "topic": "Roblox datatypes",
      "canonical": {
        "source_id": "creator-docs.engine-api",
        "path": "content/en-us/reference/engine/datatypes/**"
      },
      "secondary": {
        "source_id": "site.language-reference",
        "path": "src/content/docs/types/roblox-types.md"
      },
      "resolution": "Engine YAML is authoritative for datatype members. The site page supplies type-system framing and is context, not truth.",
      "enforcement": "authority field"
    },
    {
      "id": "OV-005",
      "topic": "Attributes - NAME COLLISION",
      "canonical": null,
      "resolution": "These are two unrelated subjects that share a word. They MUST receive different semantic tags and must never be merged, deduplicated or treated as the same topic by a retriever.",
      "distinct_subjects": [
        {
          "path": "content/en-us/scripting/attributes.md",
          "repository": "creator-docs",
          "subject": "Roblox Instance attributes",
          "semantic_tag": "roblox.instance-attributes"
        },
        {
          "path": "src/content/docs/reference/attributes.md",
          "repository": "site",
          "subject": "Luau language and type attributes",
          "semantic_tag": "luau.type-attributes"
        }
      ],
      "severity_if_violated": "high",
      "enforcement": "mandatory distinct semantic_tag"
    }
  ],
