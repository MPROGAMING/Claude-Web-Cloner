{
  "name": "blockwright",
  "version": "0.1.0",
  "private": true,
  "description": "An AI build partner for Roblox creators \u2014 describe a mechanic, get working Luau in Roblox Studio.",
  "license": "MIT",
  "keywords": [
    "roblox",
    "luau",
    "ai",
    "nextjs",
    "supabase",
    "ai-sdk"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "verify:security": "node scripts/verify-security.mjs",
    "brain:ingest": "node --import ./scripts/roblox-brain/lib/register-hooks.mjs scripts/roblox-brain/ingest.mjs",
    "brain:refresh": "node --import ./scripts/roblox-brain/lib/register-hooks.mjs scripts/roblox-brain/ingest.mjs --incremental",
    "brain:validate": "node scripts/roblox-brain/validate-corpus.mjs && node --import ./scripts/roblox-brain/lib/register-hooks.mjs scripts/roblox-brain/validate-knowledge-db.mjs",
    "brain:search": "node --import ./scripts/roblox-brain/lib/register-hooks.mjs scripts/roblox-brain/search.mjs",
    "brain:stats": "node --import ./scripts/roblox-brain/lib/register-hooks.mjs scripts/roblox-brain/stats.mjs",
    "brain:eval": "node --import ./scripts/roblox-brain/lib/register-hooks.mjs scripts/roblox-brain/evaluate.mjs",
    "brain:verify-generation": "node --import ./scripts/roblox-brain/lib/register-hooks.mjs scripts/roblox-brain/verify-generation.mjs",
    "agent:verify": "node scripts/roblox-brain/verify-agent.mjs",
    "blueprint:verify": "node scripts/roblox-brain/verify-blueprint.mjs",
    "a11y": "node scripts/a11y.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.39",
    "@ai-sdk/google": "^4.0.44",
    "@ai-sdk/openai": "^4.0.42",
    "@ai-sdk/react": "^4.0.69",
    "@base-ui/react": "^1.3.0",
    "@lobehub/icons": "^5.16.0",
    "@openrouter/ai-sdk-provider": "^3.0.0",
    "@supabase/ssr": "^0.12.4",
    "@supabase/supabase-js": "^2.112.3",
    "ai": "^7.0.66",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.6.0",
    "next": "16.3.0",
    "next-themes": "^0.4.6",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-icons": "^5.7.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.1.0",
    "simple-icons": "^16.28.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.5.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "js-yaml": "^4.3.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
