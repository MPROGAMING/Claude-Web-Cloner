# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Vercel
.vercel

# Local settings (not project config)
.claude/settings.local.json

# User-specific skills (not part of the template)
.claude/skills/customize/
.claude/skills/release/

# Local temp files
temp/

# Roblox Brain corpus — 34MB / 5,464 files of *derived* output. It is rebuilt
# deterministically from the pinned commits in source-lock.json by
# scripts/roblox-brain/normalize-corpus.mjs, so the provenance (source-lock,
# ingestion-manifest, coverage report and step reports) is versioned and the
# bulk is not.
docs/roblox-brain/corpus/

# Raw Studio captures are kept out of the repo; the optimised jpgs ship instead.
public/demos/*.png

# Agent worktrees. Each is its own git repo; committing them would nest
# repositories inside this one and make lint scan three extra copies of the
# tree — 54,000 problems on the first attempt.
.claude/worktrees/

# The benchmark holdout must never enter training data, and this repository is
# public. Nothing under a holdout directory is ever committed — only the hash
# manifest in bench/ that proves which holdout a score was measured against.
bench/holdout/
holdout/
*.holdout.jsonl
